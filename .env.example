# Global Marketplace Price & Trend Monitor
# Copy this file to .env and fill in your actual credentials.

# MySQL credentials
# For local dev (Laragon/XAMPP): host=127.0.0.1, SSL_MODE=DISABLED
# For Aiven cloud: host=<service>.aivencloud.com, port=21699, SSL_MODE=REQUIRED
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=price_monitor

# MySQL SSL (for cloud providers like Aiven)
# Options: DISABLED (local), REQUIRED (cloud, no CA check), VERIFY_CA (cloud, with cert)
MYSQL_SSL_MODE=DISABLED
# MYSQL_SSL_CA=path/to/ca.pem  # only needed when SSL_MODE=VERIFY_CA

# eBay Browse API credentials
# Get yours at: https://developer.ebay.com/
# Use PRODUCTION for live data, SANDBOX for testing
EBAY_CLIENT_ID=your_client_id_here
EBAY_CLIENT_SECRET=your_client_secret_here
EBAY_ENVIRONMENT=sandbox
